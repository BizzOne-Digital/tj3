# MongoDB (required — use MongoDB Atlas for production/Vercel)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/little-mounties?retryWrites=true&w=majority

# Public site URL (required — set to your production domain on Vercel)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# JWT secrets (required in production — use long random strings)
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string

# Admin portal login (used by `npm run set-admin` and `npm run seed` only; never read at runtime)
# Run `npm run set-admin` after changing these. Use a strong password.
ADMIN_EMAIL=tjandersty@gmail.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# SMTP — all website form emails (contact, league, partner, founding member, booking)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tjandersty@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_TO=tjandersty@gmail.com
SMTP_FROM=tjandersty@gmail.com
