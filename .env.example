# MongoDB (required — use MongoDB Atlas for production/Vercel)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/little-mounties?retryWrites=true&w=majority

# Public site URL (required — set to your production domain on Vercel)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# JWT secrets (required in production — use long random strings)
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string

# Initial admin password (used by npm run seed only)
ADMIN_PASSWORD=Admin@12345
